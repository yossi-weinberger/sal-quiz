# ============================================================
# הסל של ישראל — Environment Variables
# ============================================================
# Copy this file: cp .env.example .env.local
# Get values from: https://app.supabase.com → your project → Settings → API

# ── Required for the web app (Vercel + local dev) ──────────

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon / public key — safe to expose to browser, RLS restricts data access
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your_anon_key

# ── Required only for local scripts (NOT needed on Vercel) ─

# Service role key — full DB access, bypasses RLS
# Used by: local scripts (seed, clear, bootstrap) and optionally Vercel API rollback if response_items insert fails
# NEVER expose this to the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your_service_role_key

# Direct Postgres connection (Settings → Database → URI). Required for scripts/supabase-bootstrap.ts migration step.
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Optional: production abuse protection (recommended for public launch) ─
# Free tier: https://upstash.com — create Redis, copy REST URL + token.
# Used for /api rate limits (survey submit + read-heavy routes). If unset, limits are skipped (warns once in prod logs).

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Set to "true" only for local/debug (disables rate limits when Redis is configured).
# RATE_LIMIT_DISABLED=
